{
   "extends": "astro/tsconfigs/base",
   "compilerOptions": {
      "baseUrl": "./",
      "ignoreDeprecations": "6.0",
      "jsx": "react-jsx",
      "jsxImportSource": "react",
      "paths": {
         "@components/*": ["src/components/*"],
         "@icons/*": ["src/icons/*"],
         "@hooks/*": ["src/hooks/*"],
         "@layouts/*": ["src/layouts/*"],
         "@services/*": ["src/services/*"],
         "@utils/*": ["src/utils/*"]
      }
   }
}
