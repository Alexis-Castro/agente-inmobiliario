---

---

<form class="px-4 py-8 sm:px-10" id="formulario" enctype="multipart/form-data">
   <div class="">
      <div class="flex justify-center text-sm leading-5">
         <h2 class="px-2 text-cyan-ak text-2xl lg:text-3xl font-bold mb-5">
            Trabaja con Nosotros
         </h2>
      </div>
   </div>
   <div class="mt-6">
      <div class="w-full space-y-8">
         <div
            class="md:flex items-center justify-between gap-x-3 space-y-8 md:space-y-0">
            <div class="w-full group">
               <input
                  type="text"
                  name="nombres"
                  placeholder="Nombres"
                  class="rounded-lg flex-1 appearance-none border-2 w-full py-2.5 px-3 bg-[#010b15] border-cyan-900 transition text-gray-200 placeholder-gray-400 shadow-sm focus:outline-none focus:ring-4 focus:ring-cyan-700 focus:border-transparent"
                  required
               />
            </div>
            <div class="w-full group">
               <input
                  type="text"
                  name="apellidos"
                  placeholder="Apellidos"
                  class="rounded-lg flex-1 appearance-none border-2 w-full py-2.5 px-3 bg-[#010b15] border-cyan-900 transition text-gray-200 placeholder-gray-400 shadow-sm focus:outline-none focus:ring-4 focus:ring-cyan-700 focus:border-transparent"
                  required
               />
            </div>
         </div>

         <div
            class="md:flex items-center justify-between gap-x-3 space-y-8 md:space-y-0">
            <div class="w-full group">
               <input
                  type="email"
                  class="rounded-lg flex-1 appearance-none border-2 w-full py-2.5 px-3 bg-[#010b15] border-cyan-900 transition text-gray-200 placeholder-gray-400 shadow-sm focus:outline-none focus:ring-4 focus:ring-cyan-700 focus:border-transparent"
                  name="email"
                  placeholder="Correo"
                  required
               />
            </div>
            <div class="w-full group">
               <input
                  type="tel"
                  class="rounded-lg flex-1 appearance-none border-2 w-full py-2.5 px-3 bg-[#010b15] border-cyan-900 transition text-gray-200 placeholder-gray-400 shadow-sm focus:outline-none focus:ring-4 focus:ring-cyan-700 focus:border-transparent"
                  name="celular"
                  placeholder="Celular"
                  required
               />
            </div>
         </div>

         <div class="w-full">
            <input
               type="url"
               name="linkedln"
               id="linkedln"
               placeholder="Opcional: enlace de Linkedln"
               class="rounded-lg flex-1 appearance-none border-2 w-full py-2.5 px-3 bg-[#010b15] border-cyan-900 transition text-gray-200 placeholder-gray-400 shadow-sm focus:outline-none focus:ring-4 focus:ring-cyan-700 focus:border-transparent"
            />
         </div>

         <div class="w-full">
            <input
               class="w-full cursor-pointer border-2 border-cyan-900 rounded-lg text-gray-200 file:mr-4 file:py-2.5 file:px-4 file:rounded-lg file:border-0 file:font-semibold file:bg-[#010b15] file:text-gray-50"
               aria-describedby="cv_help"
               placeholder="Cargar CV"
               aria-label="Cargar CV"
               id="archivo"
               name="archivo"
               type="file"
               accept=".pdf"
            />
         </div>

         <div class="lg:text-sm">
            <input
               id="terminos"
               type="checkbox"
               class="w-4 h-4 transition accent-cyan-ak text-cyan-ak rounded ring-offset-gray-800-0 border-b-2 bg-white focus:ring-cyan-ak focus:ring-2"
               required
            />
            <label
               for="terminos"
               class="ml-2 font-medium mr-1 text-sm text-gray-200">
               He leído y acepto los
               <a
                  href="https://ayllukaypi.pe/terminos_condiciones"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:underline cursor-pointer text-cyan-ak font-bold js-modal-trigger">
                  Términos y Condiciones
               </a>
               y las
               <a
                  href="https://ayllukaypi.pe/politicas_privacidad"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:underline cursor-pointer text-cyan-ak font-bold js-modal-trigger">
                  Políticas de Privacidad
               </a>
            </label>
         </div>

         <div>
            <span class="block w-full rounded-md shadow-sm">
               <button
                  type="submit"
                  id="button-submit"
                  class="py-3 px-4 bg-cyan-ak hover:bg-cyan-400 focus:ring-cyan-600 focus:ring-offset-indigo-200 text-azul w-full transition ease-in duration-200 text-center text-base font-semibold shadow-md focus:outline-none focus:ring-2 focus:ring-offset-2 rounded-lg flex items-center justify-center">
                  <svg
                     role="status"
                     class="mr-3 w-5 h-5 text-azul animate-spin hidden"
                     viewBox="0 0 100 101"
                     fill="none"
                     xmlns="http://www.w3.org/2000/svg">
                     <path
                        d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z"
                        fill="#E5E7EB"></path>
                     <path
                        d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z"
                        fill="currentColor"></path>
                  </svg>
                  Postular
               </button>
            </span>
         </div>
      </div>
   </div>
</form>

