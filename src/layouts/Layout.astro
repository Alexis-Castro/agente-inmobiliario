---
export interface Props {
   title: string;
}

const { title } = Astro.props;
// import "@fontsource/koho"
import "@fontsource/koho/500.css";
import "@fontsource/koho/700.css";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
   <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width" />
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <!-- <meta name="generator" content={Astro.generator} /> -->
      <title>{title}</title>
   </head>
   <body class="bg-[#010B15]">
      <wc-toast></wc-toast>
      <slot />
   </body>
</html>

<script>
   const btnPostula = document.querySelector(
      "#btnPostula",
   ) as HTMLAnchorElement;

   btnPostula.addEventListener("click", clickHandler);

   function clickHandler(this: any, e: { preventDefault: () => void }) {
      e.preventDefault();

      const href = this.getAttribute("href");
      document.querySelector(href).scrollIntoView({
         behavior: "smooth",
      });
   }
</script>
